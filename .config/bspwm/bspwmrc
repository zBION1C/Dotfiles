#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &

# Layout
bspc config automatic_scheme      alternate
bspc config initial_polarity      second_child
bspc config removal_adjustment    true

# Workspace configuration
bspc monitor -d I II III IV V

# Mouse click drag-and-drop 
bspc config pointer_modifier      mod1

# Border configuration
bspc config border_width          3 
bspc config borderless_monocle    true
bspc config normal_border_color   "#333333"
bspc config focused_border_color  "#70d6ff"

# Gap configuration
bspc config window_gap            15
bspc config gapless_monocle       false

# Window rules configuration
bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
bspc rule -a Wrapper-2.0 center=off rectangle=700x600+0+0 state=floating
bspc rule -a "VirtualBox Manager" state=floating rectangle=900x700+0+0 center=on
bspc rule -a jetbrains-studio state=floating rectangle=800x600+0+0 center=on
bspc rule -a qemu-system-x86_64  state=floating center=on

# ─── EXTERNAL RULES ────────────────────────────────────────
bspc config external_rules_command "$HOME/.config/bspwm/external_rules"
